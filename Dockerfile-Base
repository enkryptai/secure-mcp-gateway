FROM python:3.11-alpine

WORKDIR /app

# Install build dependencies required for psutil and other packages
RUN apk add --no-cache --virtual .build-deps \
    gcc \
    python3-dev \
    musl-dev \
    linux-headers \
    && apk add --no-cache \
    libffi-dev

# Install the frozen runtime environment.
RUN pip install --no-cache-dir uv
COPY pyproject.toml uv.lock README_PYPI.md ./
RUN uv sync --frozen --no-dev --no-install-project

# Copy source code
COPY src src
COPY MANIFEST.in MANIFEST.in
# Other files
COPY CHANGELOG.md CHANGELOG.md
COPY LICENSE LICENSE
COPY README.md README.md
COPY README_PYPI.md README_PYPI.md

# For ingress to work
ENV HOST=0.0.0.0
ENV FASTAPI_HOST=0.0.0.0

# Build and install the checked-out project with the setuptools backend.
RUN uv sync --frozen --no-dev && apk del .build-deps

EXPOSE 8000

# Set the entrypoint to the script
# ENTRYPOINT ["python", "src/secure_mcp_gateway/gateway.py"]
ENTRYPOINT [".venv/bin/mcp", "run", "src/secure_mcp_gateway/gateway.py"]
