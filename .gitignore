# ── Virtual environments ────────────────────────────────────────────────
.venv/
venv/
*venv*/
.secure-mcp-gateway-venv/

# ── Python build / dist ─────────────────────────────────────────────────
build/
dist/
*.egg-info/
__pycache__/
*.py[cod]
*.pyo

# ── IDE & editor ────────────────────────────────────────────────────────
.cursor/
.cursorignore
.cursorrules
.cursorsettings
.vscode/
.idea/

# ── Claude / AI local settings ──────────────────────────────────────────
.claude/

# ── OS files ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Environment & secrets ───────────────────────────────────────────────
# Real env files (with secrets) — never commit.
**/.env
.env.*
# …but DO commit the templates that ship with the repo.
# Without these un-ignore rules the `.env.*` glob above swallows
# observability/.env.example (and any future *.env.example), which
# silently breaks new-operator setup. Confirmed 2026-05-05 with
# `git check-ignore -v observability/.env.example`.
!**/.env.example
!**/.env.template
!**/.env.sample
enkrypt_mcp_config*.json*

# ── Logs ────────────────────────────────────────────────────────────────
logs/
*.log

# ── Tool caches ─────────────────────────────────────────────────────────
.ruff_cache/
.pytest_cache/
.mypy_cache/

# ── Misc generated / temp ───────────────────────────────────────────────
.python-version
uv.lock
node_modules/
package.json
package-lock.json
tmp/
tmp.py
main.py

# ── Security checks ────────────────────────────────────────────────────
bandit-report.json

# ── Legacy scripts ──────────────────────────────────────────────────────
scripts/flake8/backups/

# ── Playwright MCP artifacts ─────────────────────────────────────────
.playwright-mcp/
tests/traces/

# ── Docs / manifests ───────────────────────────────────────────────────
docs/secure-mcp-gateway-manifest.yaml
