.DS_Store
Thumbs.db

# ── Environment & secrets ───────────────────────────────────────────────
# Real env files (with secrets) — never commit.
**/.env
.env.*
# …but DO commit the templates that ship with the repo.
# Without these un-ignore rules the `.env.*` glob above swallows
# the committed templates, which silently breaks new-operator setup.
# The `.env*.example` glob covers per-stack templates too:
# observability/.env.grafana.example, .env.opensearch.example, etc.
# (the old `!**/.env.example` rule only matched the literal basename
# `.env.example` and silently dropped `.env.opensearch.example`).
# Confirmed with `git check-ignore -v observability/.env.grafana.example`.
!**/.env*.example
!**/.env.template
!**/.env.sample
enkrypt_mcp_config*.json*

# ── Logs ────────────────────────────────────────────────────────────────
logs/
*.log

# ── Tool caches ─────────────────────────────────────────────────────────
.ruff_cache/
.pytest_cache/
.mypy_cache/

# ── Misc generated / temp ───────────────────────────────────────────────
.python-version
uv.lock
node_modules/
package.json
package-lock.json
tmp/
tmp.py
main.py

# ── Security checks ────────────────────────────────────────────────────
bandit-report.json

# ── Legacy scripts ──────────────────────────────────────────────────────
scripts/flake8/backups/

# ── Playwright MCP artifacts ─────────────────────────────────────────
.playwright-mcp/
tests/traces/

