# Dockerfile.patch-tier1metrics
# ---------------------------------------------------------------------------
# "Patch image" -- starts from the official `enkryptai/secure-mcp-gateway:v2.2.0`
# image and OVERLAYS Tier-1 telemetry instrumentation (PR #41) plus the
# session_pool fix (PR #40).
#
# Key wrinkle: my `main`-branch source has DIVERGED from v2.2.0 (v2.2.0
# ships classes like TransportError that aren't on main yet).  Overlaying
# my whole files would BREAK v2.2.0's imports.  So before building this
# image we run:
#
#     python tools/build_tier1_overlay.py
#
# which dumps each affected file out of the v2.2.0 image, surgically
# applies only the Tier-1 additions, and writes the merged result to
# build/tier1_overlay/.  THIS DOCKERFILE then COPYs from that directory.
#
# Build:
#   python tools/build_tier1_overlay.py
#   docker build -f Dockerfile.patch-tier1metrics \
#     -t enkryptai/secure-mcp-gateway:v2.2.0-tier1metrics .
#
# What's in the merged overlay (vs official v2.2.0):
#   - exceptions.py:  MCPGatewayError.__init__ now also emits
#                     enkrypt.errors.by_code via record_error_by_code().
#                     Auto-fires from EVERY gateway error -- no per-call-site
#                     instrumentation required.
#   - conventions.py: 7 new MetricNames constants + descriptions.
#   - opentelemetry_provider.py: 7 new counter instruments (active + NoOp).
#   - metrics_helpers.py: 6 new no-op-safe helpers
#                         (record_compliance_hits, record_error_by_code,
#                         record_tool_permission_denied, record_degradation,
#                         record_transport_error, record_discovery_failure).
#   - config_manager.py: 7 new @property accessors.  THIS IS THE FIX from
#                        commit 5f68755 -- without it the helpers silently
#                        no-op because metrics_helpers._add() looks up the
#                        counter via getattr(mgr, "<name>", None), and the
#                        manager wraps every metric in a @property.
#   - services/session/session_pool.py: PR #40 asyncio.wait_for guards
#                                        around acquire() (proven safe in
#                                        the v2.2.0-sessionpoolpatch image
#                                        already in production).
#
# Out of scope (won't fit cleanly on v2.2.0's lines and the value is
# incremental):
#   - secure_tool_execution_service.py call sites for
#     compliance_hits/permission_denied/degradation
#   - discovery_service.py call site for record_discovery_failure
#   - error_handling.py doc-only update
#
# Net effect: errors_by_code AUTO-emits (unlocks ~9 widgets in Error
# Forensics) + session_pool hang protection.  Compliance/permission/
# degradation/discovery metrics ship in a future PR that lands on main
# first so v2.2.0 and main stay in lock-step.
# ---------------------------------------------------------------------------
FROM enkryptai/secure-mcp-gateway:v2.2.0

# CRITICAL: v2.2.0's CMD runs ``python src/secure_mcp_gateway/gateway.py``
# from ``/app``, NOT ``python -m secure_mcp_gateway.gateway`` from
# site-packages.  Patches must overlay /app/src/secure_mcp_gateway/ to
# affect the running gateway -- patches in site-packages would only
# affect ``python3 -c`` probes (which is exactly the bug we hit during
# dev verification of the audit work and discovered with the disassembly
# trail).  We still also overlay site-packages so the verify script's
# ``import secure_mcp_gateway.*`` checks resolve to the patched source,
# AND so future probes / out-of-band tooling sees the same code.
ARG PKG_ROOT=/app/src/secure_mcp_gateway
ARG SITE_PKG_ROOT=/usr/local/lib/python3.12/dist-packages/secure_mcp_gateway

# --- All Tier-1 + session_pool overlay files come from build/tier1_overlay/
# generated by tools/build_tier1_overlay.py.  Do NOT replace these with the
# raw src/ files -- see header comment.
COPY build/tier1_overlay/exceptions.py \
     ${PKG_ROOT}/exceptions.py
COPY build/tier1_overlay/plugins/telemetry/conventions.py \
     ${PKG_ROOT}/plugins/telemetry/conventions.py
COPY build/tier1_overlay/plugins/telemetry/opentelemetry_provider.py \
     ${PKG_ROOT}/plugins/telemetry/opentelemetry_provider.py
COPY build/tier1_overlay/plugins/telemetry/metrics_helpers.py \
     ${PKG_ROOT}/plugins/telemetry/metrics_helpers.py
COPY build/tier1_overlay/plugins/telemetry/config_manager.py \
     ${PKG_ROOT}/plugins/telemetry/config_manager.py
COPY build/tier1_overlay/services/session/session_pool.py \
     ${PKG_ROOT}/services/session/session_pool.py

# --- Guardrail-detail: STES per-detector PII + toxicity emission -----------
# Surgically patches v2.2.0's secure_tool_execution_service.py at the 3
# guardrail-violation sites (input, sync output, async output) so each
# blocked call also fires record_pii_entities + record_toxicity_subtypes.
# Unlocks the Guardrails Deep Dive "PII Entities by Direction", "Top PII
# Entity Types", "Toxicity Subtypes" and "Top Toxicity Subtypes by Score
# Bucket" panels.
COPY build/tier1_overlay/services/execution/secure_tool_execution_service.py \
     ${PKG_ROOT}/services/execution/secure_tool_execution_service.py

# --- Cache & Performance: cache_service phase_timer + session_pool gauge ---
# cache_service.py wraps the cache lookup with phase_timer("cache_lookup_
# duration_ms").  session_pool.py is ALREADY copied from v2.2.0-sessionpool
# patch image above; the overlay tool's patch_session_pool layered the
# MCP-handshake timer + record_session_active gauge wiring on top before
# the file was written, so no extra COPY line is needed for it.
COPY build/tier1_overlay/services/cache/cache_service.py \
     ${PKG_ROOT}/services/cache/cache_service.py

# --- Audit (Phase A + B) -- new modules + api_server.py patch --------------
COPY build/tier1_overlay/audit.py \
     ${PKG_ROOT}/audit.py
COPY build/tier1_overlay/audit_middleware.py \
     ${PKG_ROOT}/audit_middleware.py
COPY build/tier1_overlay/api_server.py \
     ${PKG_ROOT}/api_server.py
COPY build/tier1_overlay/gateway_cache_routes.py \
     ${PKG_ROOT}/gateway_cache_routes.py

# --- Playground: new gateway_playground_routes.py + patched gateway.py ----
# Mounts /mcp-playground/{test-server,get-tools,call-tool} onto FastMCP
# so the playground UI works against the existing :8000 ingress without
# needing api_server.py to run in a separate process / container.
COPY build/tier1_overlay/gateway_playground_routes.py \
     ${PKG_ROOT}/gateway_playground_routes.py
COPY build/tier1_overlay/gateway.py \
     ${PKG_ROOT}/gateway.py

# --- Mirror /app/src patches to site-packages ------------------------------
# So that ``import secure_mcp_gateway.X`` from any context (the verify
# script, ad-hoc ``python -c`` probes, future tooling) hits the SAME
# patched source the runtime gateway is using.  Without this, the two
# paths drift and bugs become impossible to reason about.
RUN cp -r ${PKG_ROOT}/. ${SITE_PKG_ROOT}/

# --- Bust the bytecode caches at BOTH locations ----------------------------
# Without this, Python loads the pre-existing ``.pyc`` from v2.2.0's
# ``__pycache__`` because the .pyc's stored SOURCE_HASH still matches
# (the COPY rewrites .py but doesn't touch .pyc; the hash check in
# PEP 552 .pyc headers wins over mtime).  Result: patched .py on disk
# but gateway silently runs the old v2.2.0 bytecode and none of the
# audit instrumentation fires.  Caught the hard way -- a print()
# injected into ``gateway_cache_routes._flush_handler`` never appeared
# in the pod log even though the file had it.
RUN find ${PKG_ROOT} ${SITE_PKG_ROOT} -type d -name __pycache__ -exec rm -rf {} + && \
    python3 -m compileall -q ${PKG_ROOT} ${SITE_PKG_ROOT}

# --- Build-time sanity check ------------------------------------------------
# Fails the build if any patch isn't actually present in the copied file.
# Catches stale-checkout and missed-merge bugs before the image is pushed.
COPY tools/verify_patch_tier1.py /tmp/verify_patch_tier1.py
RUN python3 /tmp/verify_patch_tier1.py && rm /tmp/verify_patch_tier1.py
