{
    "index_patterns": ["ss4o_logs-gateway*"],
    "data_stream": { "timestamp_field": { "name": "time" } },
    "priority": 1000,
    "_meta": {
      "description": "SS4O logs for Secure MCP Gateway. dynamic:false. Groups: OTel core; resource attrs; identity tuple (snake_case); operational ids (custom_id/request_id/correlation_id/mcp_config_id/session_id); tool-batch counts; misc; code context; error system; health & playground; cache & discovery flow; tool deny-list; cloud registry; guardrail violation arrays; per-call detector signal (with `direction` keyword = input|output discriminating pre-tool vs post-tool checks across all detector_* / pii_*_count / bias_detected / *_similarity / compliance_*_hit fields); policy metadata; gateway-config metadata; guardrail naming (guardrail_name / input_guardrail_name / output_guardrail_name / server_tools_guardrail_name / server_info_guardrail_name — all aligned with cloud config `*_guardrails_config.guardrail_name` field, not `policy_name`); sandbox subsystem; request-type discriminators (request_type/source_event/mcp_method); input/output sizing + 3-phase latency split (preprocess/execution/postprocess); per-operation latency cluster (total_request/tool_call/forward/discovery/list_servers/server_info/auth/guardrail/input_guardrail/output_guardrail/relevancy/adherence/hallucination/pii_redact/pii_restore/cache_lookup/cache_write/cloud_api/cloud_auth_fetch/oauth/oauth_token_acquire/oauth_token_refresh/registry_lookup/consumer_info_lookup/mcp_initialize/mcp_handshake/config_reload/queue_wait — all `*_duration_ms` doubles); guardrail registration metadata; session pool; OAuth; timeout escalation; hot reload; async guardrails; MCP protocol; tool annotations; admin/audit; discovery/listing supplementals."
    },
    "template": {
      "settings": {
        "number_of_shards": 1,
        "number_of_replicas": 0,
        "opendistro.index_state_management.policy_id": "gateway_telemetry_policy",
        "plugins.index_state_management.rollover_alias": "ss4o_logs-gateway",
        "mapping.total_fields.limit": "1000",
        "refresh_interval": "5s"
      },
      "aliases": { "gateway-logs": {} },
      "mappings": {
        "dynamic": "false",
        "_source": { "enabled": true },
        "properties": {
          "@timestamp":                 { "type": "date" },
          "time":                       { "type": "date_nanos" },
          "observedTimestamp":          { "type": "date" },
  
          "traceId":                    { "type": "keyword", "ignore_above": 256 },
          "spanId":                     { "type": "keyword", "ignore_above": 256 },
          "traceFlags":                 { "type": "integer" },
          "flags":                      { "type": "integer" },
          "severityNumber":             { "type": "integer" },
