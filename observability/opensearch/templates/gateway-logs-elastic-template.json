{
  "index_patterns": ["ss4o_logs-gateway*"],
  "data_stream": {
    "timestamp_field": { "name": "time" }
  },
  "priority": 1000,
  "_meta": {
    "description": "SS4O logs for Secure MCP Gateway. Populated by Data Prepper's otel_logs_source (no processor required). Schema is locked down with `dynamic: false`: any field not declared below is kept in `_source` but is NOT indexed (won't appear in the OSD field list and isn't searchable). To add a new emitted field, edit this template and reapply with the bootstrap script in the apiaas repo. Identity attributes (user_id / user_email / project_id / project_name / project_registry / org_id / gateway_name / gateway_version / server_name / tool_name) live under `log.attributes.*` in snake_case only -- see docs/metric_attributes_key_mismatch.md for the toggle that controls dual emission with the canonical `enkrypt@*` form."
  },
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "opendistro.index_state_management.policy_id": "gateway_telemetry_policy",
      "plugins.index_state_management.rollover_alias": "ss4o_logs-gateway",
      "mapping.total_fields.limit": "500",
      "refresh_interval": "5s"
    },
    "aliases": {
      "gateway-logs": {}
    },
    "mappings": {
      "dynamic": "false",
      "_source": { "enabled": true },
      "properties": {
        "@timestamp":                 { "type": "date" },
        "time":                       { "type": "date_nanos" },
        "observedTimestamp":          { "type": "date" },

        "traceId":                    { "type": "keyword", "ignore_above": 256 },
        "spanId":                     { "type": "keyword", "ignore_above": 256 },
        "traceFlags":                 { "type": "integer" },
        "flags":                      { "type": "integer" },
        "severityNumber":             { "type": "integer" },
        "severityText":               { "type": "keyword", "ignore_above": 32 },
        "schemaUrl":                  { "type": "keyword", "ignore_above": 256 },
        "serviceName":                { "type": "keyword", "ignore_above": 256 },
        "droppedAttributesCount":     { "type": "integer" },

        "body": {
          "type": "text",
          "fields": {
            "keyword": { "type": "keyword", "ignore_above": 8192 }
          }
        },

        "instrumentationScope.name":    { "type": "keyword", "ignore_above": 256 },
        "instrumentationScope.version": { "type": "keyword", "ignore_above": 64 },

        "resource.attributes.job":          { "type": "keyword", "ignore_above": 64 },
        "resource.attributes.service@name": { "type": "keyword", "ignore_above": 256 },
        "resource.attributes.host@name":    { "type": "keyword", "ignore_above": 256 },

        "log.attributes.user_id":          { "type": "keyword", "ignore_above": 256, "null_value": "not_provided" },
        "log.attributes.user_email":       { "type": "keyword", "ignore_above": 256, "null_value": "not_provided" },
        "log.attributes.project_id":       { "type": "keyword", "ignore_above": 256, "null_value": "not_provided" },
        "log.attributes.project_name":     { "type": "keyword", "ignore_above": 256, "null_value": "not_provided" },
        "log.attributes.project_registry": { "type": "keyword", "ignore_above": 256, "null_value": "not_provided" },
        "log.attributes.org_id":           { "type": "keyword", "ignore_above": 256, "null_value": "not_provided" },
        "log.attributes.gateway_name":     { "type": "keyword", "ignore_above": 256, "null_value": "not_provided" },
        "log.attributes.gateway_version":  { "type": "keyword", "ignore_above": 256, "null_value": "not_provided" },
        "log.attributes.server_name":      { "type": "keyword", "ignore_above": 256 },
        "log.attributes.tool_name":        { "type": "keyword", "ignore_above": 256 },

        "log.attributes.mcp_config_id":    { "type": "keyword", "ignore_above": 256, "null_value": "not_provided" },
        "log.attributes.custom_id":        { "type": "keyword", "ignore_above": 256 },
        "log.attributes.request_id":       { "type": "keyword", "ignore_above": 256 },
        "log.attributes.correlation_id":   { "type": "keyword", "ignore_above": 256 },
        "log.attributes.error":            { "type": "keyword", "ignore_above": 1024 },

        "log.attributes.num_tool_calls":   { "type": "long" },
        "log.attributes.successful_calls": { "type": "long" },
        "log.attributes.failed_calls":     { "type": "long" },
        "log.attributes.blocked_calls":    { "type": "long" },

        "log.attributes.tool_arguments": {
          "type": "text",
          "fields": {
            "keyword": { "type": "keyword", "ignore_above": 8192 }
          }
        },
        "log.attributes.providers":        { "type": "keyword", "ignore_above": 256 },
        "log.attributes.version":          { "type": "keyword", "ignore_above": 64 },

        "log.attributes.code@file@path":     { "type": "keyword", "ignore_above": 1024 },
        "log.attributes.code@function@name": { "type": "keyword", "ignore_above": 256 },
        "log.attributes.code@line@number":   { "type": "long" },

        "log.attributes._logger":  { "type": "keyword", "ignore_above": 256 },
        "log.attributes._name":    { "type": "keyword", "ignore_above": 64 }
      }
    }
  }
}
