{
  "index_patterns": ["ss4o_metrics-gateway*"],
  "data_stream": {
    "timestamp_field": { "name": "time" }
  },
  "priority": 1000,
  "_meta": {
    "description": "SS4O metrics for Secure MCP Gateway. Populated by Data Prepper's otel_metrics processor. Schema is locked down with `dynamic: false`: any field not declared below is kept in `_source` but is NOT indexed (won't appear in the OSD field list and isn't searchable). To add a new emitted metric attribute, edit this template and reapply with the bootstrap script in the apiaas repo. Identity attributes (user_id / user_email / project_id / project_name / project_registry / org_id / gateway_name / gateway_version / server_name / tool_name) live under `metric.attributes.*` in snake_case only -- see docs/metric_attributes_key_mismatch.md for the toggle that controls dual emission with the canonical `enkrypt@*` form."
  },
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "opendistro.index_state_management.policy_id": "gateway_telemetry_policy",
      "plugins.index_state_management.rollover_alias": "ss4o_metrics-gateway",
      "mapping.total_fields.limit": "500",
      "refresh_interval": "5s"
    },
    "aliases": {
      "gateway-metrics": {}
    },
    "mappings": {
      "dynamic": "false",
      "_source": { "enabled": true },
      "properties": {
        "@timestamp":             { "type": "date" },
        "time":                   { "type": "date_nanos" },
        "startTime":              { "type": "date_nanos" },
        "observedTimestamp":      { "type": "date" },

        "name":                   { "type": "keyword", "ignore_above": 256 },
        "description":            { "type": "text" },
        "unit":                   { "type": "keyword", "ignore_above": 64 },
        "kind":                   { "type": "keyword", "ignore_above": 32 },
        "aggregationTemporality": { "type": "keyword", "ignore_above": 64 },
        "isMonotonic":            { "type": "boolean" },
        "flags":                  { "type": "integer" },
        "schemaUrl":              { "type": "keyword", "ignore_above": 256 },
        "serviceName":            { "type": "keyword", "ignore_above": 256 },

        "value":               { "type": "double" },
        "count":               { "type": "long" },
        "sum":                 { "type": "double" },
        "min":                 { "type": "double" },
        "max":                 { "type": "double" },
        "bucketCounts":        { "type": "long" },
        "bucketCountsList":    { "type": "long" },
        "explicitBounds":      { "type": "double" },
        "explicitBoundsCount": { "type": "integer" },

        "buckets": {
          "type": "nested",
          "properties": {
            "count":      { "type": "long" },
            "sum":        { "type": "double" },
            "max":        { "type": "double" },
            "min":        { "type": "double" },
            "upperBound": { "type": "double" }
          }
        },
        "exemplars": {
          "type": "nested",
          "properties": {
            "time":    { "type": "date_nanos" },
            "traceId": { "type": "keyword", "ignore_above": 256 },
            "spanId":  { "type": "keyword", "ignore_above": 256 },
            "value":   { "type": "double" }
          }
        },

        "instrumentationScope.name":    { "type": "keyword", "ignore_above": 256 },
        "instrumentationScope.version": { "type": "keyword", "ignore_above": 64 },

        "resource.attributes.job":          { "type": "keyword", "ignore_above": 64 },
        "resource.attributes.service@name": { "type": "keyword", "ignore_above": 256 },
        "resource.attributes.host@name":    { "type": "keyword", "ignore_above": 256 },

        "metric.attributes.user_id":          { "type": "keyword", "ignore_above": 256, "null_value": "not_provided" },
        "metric.attributes.user_email":       { "type": "keyword", "ignore_above": 256, "null_value": "not_provided" },
        "metric.attributes.project_id":       { "type": "keyword", "ignore_above": 256, "null_value": "not_provided" },
        "metric.attributes.project_name":     { "type": "keyword", "ignore_above": 256, "null_value": "not_provided" },
        "metric.attributes.project_registry": { "type": "keyword", "ignore_above": 256, "null_value": "not_provided" },
        "metric.attributes.org_id":           { "type": "keyword", "ignore_above": 256, "null_value": "not_provided" },
        "metric.attributes.gateway_name":     { "type": "keyword", "ignore_above": 256, "null_value": "not_provided" },
        "metric.attributes.gateway_version":  { "type": "keyword", "ignore_above": 256, "null_value": "not_provided" },
        "metric.attributes.server_name":      { "type": "keyword", "ignore_above": 256 },
        "metric.attributes.tool_name":        { "type": "keyword", "ignore_above": 256 },

        "metric.attributes.mcp_config_id":    { "type": "keyword", "ignore_above": 256, "null_value": "not_provided" },
        "metric.attributes.custom_id":        { "type": "keyword", "ignore_above": 256 },
        "metric.attributes.error":            { "type": "keyword", "ignore_above": 1024 },

        "metric.attributes.outcome":        { "type": "keyword", "ignore_above": 32 },
        "metric.attributes.direction":      { "type": "keyword", "ignore_above": 32 },
        "metric.attributes.status_code":    { "type": "keyword", "ignore_above": 16 },
        "metric.attributes.provider":       { "type": "keyword", "ignore_above": 64 },
        "metric.attributes.check_kind":     { "type": "keyword", "ignore_above": 64 },
        "metric.attributes.violation_type": { "type": "keyword", "ignore_above": 128 },
        "metric.attributes.block_reason":   { "type": "keyword", "ignore_above": 128 },
        "metric.attributes.failure_reason": { "type": "keyword", "ignore_above": 128 },
        "metric.attributes.cache":          { "type": "keyword", "ignore_above": 16 },
        "metric.attributes.result":         { "type": "keyword", "ignore_above": 32 },

        "metric.attributes.otel@span@parent@origin":  { "type": "keyword", "ignore_above": 64 },
        "metric.attributes.otel@span@sampling_result": { "type": "keyword", "ignore_above": 64 }
      }
    }
  }
}
