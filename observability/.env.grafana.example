# ---------------------------------------------------------------------------
# observability/.env.example  --  copy to observability/.env and edit.
#
# `docker compose -f observability/docker-compose.yml up` auto-loads
# observability/.env (compose looks in the same dir as the compose file).
# Anything you set here is substituted at container startup --
# see the `${VAR}` placeholders in docker-compose.yml and the
# Grafana provisioning files under grafana/provisioning/.
#
# .env is gitignored.  This template is committed so new operators have
# a known-good starting point.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Slack notifications
# ---------------------------------------------------------------------------
# Generate (or rotate) an incoming webhook for the alert channel:
#   https://api.slack.com/apps -> your app -> Incoming Webhooks -> Add New
# Paste the resulting https://hooks.slack.com/services/... URL below.
#
# Substituted into:
#   grafana/provisioning/alerting/contact-points.yaml  ->  url: $SLACK_WEBHOOK_URL
#
# If you leave this blank, Grafana provisioning will still succeed but
# Slack POSTs will silently fail with a "no destination" error visible in
# `docker logs ... grafana`.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/WITH/YOUR_WEBHOOK

# ---------------------------------------------------------------------------
# OTel Collector host ports (legacy Grafana stack)
# ---------------------------------------------------------------------------
# OpenSearch is the primary backend and owns the OTel defaults 4317/4318
# (see .env.opensearch.example). This Grafana stack publishes on 4327/4328
# so the two don't collide. To use this stack, point the gateway's
# plugins.telemetry.config.url at http://localhost:4327. Override here
# only if 4327/4328 are already taken on your host.
OTEL_OTLP_HOST_PORT_GRPC=4327
OTEL_OTLP_HOST_PORT_HTTP=4328

# ---------------------------------------------------------------------------
# Grafana host port
# ---------------------------------------------------------------------------
# Defaults to 3001 in docker-compose.yml.  Override here if 3001 is taken
# (common on Windows where Docker Desktop's WSL relay or a native
# Grafana service installer claims port 3000/3001).
#
# Recommended fallbacks: 3030, 3300, 8080.
# Visit Grafana at http://localhost:${GRAFANA_HOST_PORT}/
GRAFANA_HOST_PORT=3001
