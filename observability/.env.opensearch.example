# ---------------------------------------------------------------------------
# observability/.env.opensearch.example  --  copy to .env.opensearch and edit.
#
# Used by `docker compose -f docker-compose.opensearch.yml --env-file .env.opensearch up`
# (this file is NOT auto-loaded; compose only auto-loads `.env`, so the
# --env-file flag is required).
#
# Substituted into:
#   - docker-compose.opensearch.yml  (OPENSEARCH_INITIAL_ADMIN_PASSWORD,
#                                     host ports, heap size)
#   - data_prepper/pipelines.yaml    (OPENSEARCH_USERNAME, OPENSEARCH_PASSWORD)
# ---------------------------------------------------------------------------

# OpenSearch 2.12+ refuses to start without this set, and rejects weak
# passwords. Required complexity: 8+ chars, upper, lower, digit, symbol.
# Local dev only -- never reuse a real cluster password here.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=ChangeMe!Str0ngP@ss

# ---------------------------------------------------------------------------
# Password for the least-privilege `mcp_gateway_telemetry_plugin` user that
# Data Prepper writes as. Created automatically by opensearch-bootstrap
# via the Security plugin REST API (mirrors what k8s gets from
# securityadmin.sh + apps/opensearch/dev/security-config.yaml in prod).
#
# Same complexity rules as the admin password. Intentionally exercises a
# password character set that would break the legacy `sed`-based template
# renderer (| & $) -- the current Python-based renderer
# (data_prepper/render_pipelines.py) handles them. Rotate freely.
# ---------------------------------------------------------------------------
MCP_GATEWAY_TELEMETRY_PLUGIN_PASSWORD=Gateway|Telemetry&Plug1n!

# ---------------------------------------------------------------------------
# Host port overrides. OpenSearch is the primary backend, so it claims the
# OTel default ports 4317 (gRPC) / 4318 (HTTP) -- the gateway's default
# telemetry endpoint (http://localhost:4317) lands here with NO config
# change. The legacy Grafana stack (docker-compose.yml) moved to 4327/4328.
# You normally run ONE backend; override these only if 4317/4318 are
# already taken on your host.
#
# Visit OpenSearch Dashboards at http://localhost:${OS_DASHBOARDS_HOST_PORT}/
# ---------------------------------------------------------------------------
OS_OTLP_HOST_PORT_GRPC=4317
OS_OTLP_HOST_PORT_HTTP=4318
OS_DASHBOARDS_HOST_PORT=5601
OS_HTTP_HOST_PORT=9200
OS_PERF_HOST_PORT=9600

# ---------------------------------------------------------------------------
# OpenSearch heap (single-node dev). Bump to 4g+ if you push real volume.
# ---------------------------------------------------------------------------
OS_HEAP_SIZE=2g

# ---------------------------------------------------------------------------
# Slack webhook for alert notifications. Bootstrap creates the channel
# regardless (so monitors can reference it by id), but actual Slack POSTs
# will fail with this placeholder. Replace once you have a real webhook.
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/WITH/YOUR_WEBHOOK

# ---------------------------------------------------------------------------
# Set to 1 to apply only ISM policies + index templates (skip notification
# channels and alert monitors). Useful for staging clusters where you do
# NOT want pager noise yet.
# ---------------------------------------------------------------------------
SKIP_MONITORS=0
